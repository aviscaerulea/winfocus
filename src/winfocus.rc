// バージョン情報リソース
// APP_VERSION_NUM（カンマ区切り 4 数値）と APP_VERSION_STR（表示用文字列）は
// build.ps1 が out\version.rc.h として生成する。rc.exe には生成先を /I で与える。
// 本ファイルは日本語コメントを含むため rc.exe に /c65001 が必須である。
// 無指定だと CP932 で MBCS 走査され、行末バイトがリードバイト範囲に当たると次行が消える。
//
// FileDescription と ProductName が空だと、Windows のアプリ一覧 UI（音量ミキサー等）が
// 表示名を exe の親フォルダ名で代替する。Scoop 配置ではバージョン番号がフォルダ名になるため、
// アプリ名がバージョン番号として表示されてしまう。
#include <winver.h>
#include "version.rc.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    APP_VERSION_NUM
PRODUCTVERSION APP_VERSION_NUM
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0x0L
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0409 = 米国英語、04B0 = Unicode。日本語環境でも文字化けせず読める組み合わせである。
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Takayuki Nikai"
            VALUE "FileDescription",  "winfocus - Window Aggregation Tool"
            VALUE "FileVersion",      APP_VERSION_STR
            VALUE "InternalName",     "winfocus"
            VALUE "LegalCopyright",   "Copyright (c) 2025 Takayuki Nikai"
            VALUE "OriginalFilename", "winfocus.exe"
            VALUE "ProductName",      "winfocus"
            VALUE "ProductVersion",   APP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 0x04B0
    END
END
